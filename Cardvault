<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CardVault - Baseball & Sports Card Storefront</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .gradient-card {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #0f172a;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 3px;
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen font-sans flex flex-col justify-between custom-scrollbar">

    <!-- Navigation Header -->
    <header class="bg-slate-900 border-b border-slate-800 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="bg-blue-600 p-2 rounded-lg text-white font-black text-xl tracking-wider">CV</div>
                <div>
                    <h1 class="text-xl font-bold tracking-tight text-white">CardVault</h1>
                    <p class="text-xs text-slate-400">Custom Bundles & Direct Payment Options</p>
                </div>
            </div>
            
            <div class="flex items-center space-x-4">
                <button onclick="openCartModal()" class="relative bg-slate-800 hover:bg-slate-700 text-slate-200 px-4 py-2 rounded-lg font-medium transition flex items-center space-x-2 border border-slate-700">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" />
                    </svg>
                    <span>Cart</span>
                    <span id="cart-count" class="bg-blue-600 text-white text-xs font-bold px-2 py-0.5 rounded-full">0</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Storefront Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow w-full">
        
        <!-- OfferUp Announcement Banner -->
        <div class="bg-emerald-950/60 border border-emerald-800/80 rounded-xl p-4 mb-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
            <div class="flex items-center space-x-3">
                <span class="flex h-3 w-3 relative">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                </span>
                <div>
                    <h2 class="text-emerald-300 font-bold text-sm uppercase tracking-wide">OfferUp Buyer Welcome</h2>
                    <p class="text-slate-300 text-sm">Select local pickup at checkout for cash meetups, or pay via PayPal, Cash App, or Apple Pay for shipping!</p>
                </div>
            </div>
            <div class="text-xs text-emerald-400 bg-emerald-900/50 px-3 py-1.5 rounded-lg border border-emerald-700/50">
                Threshold Rule: Individual listings ≥ $1.51
            </div>
        </div>

        <!-- Filter Controls -->
        <div class="flex flex-col md:flex-row justify-between items-stretch md:items-center gap-4 mb-8">
            <div class="relative flex-1">
                <input type="text" id="search-input" onkeyup="filterCards()" placeholder="Search player, team, set, or year..." class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-2.5 pl-10 text-slate-200 placeholder-slate-500 focus:outline-none focus:border-blue-500">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-500 absolute left-3 top-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </div>
            <div class="flex items-center space-x-3">
                <select id="sort-select" onchange="filterCards()" class="bg-slate-900 border border-slate-800 rounded-lg px-3 py-2.5 text-slate-300 text-sm focus:outline-none focus:border-blue-500">
                    <option value="newest">Newest Listed</option>
                    <option value="price-low">Price: Low to High</option>
                    <option value="price-high">Price: High to Low</option>
                </select>
            </div>
        </div>

        <!-- Card Grid / Empty State Container -->
        <div id="card-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            <!-- Dynamic Content Injected via JS -->
        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 border-t border-slate-800 py-6 text-center text-slate-500 text-xs">
        <p>© CardVault Storefront. Safe Local Pickup & Nationwide Shipping.</p>
    </footer>

    <!-- Cart / Checkout Modal -->
    <div id="cart-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-xl w-full max-w-lg p-6 relative flex flex-col max-h-[90vh]">
            <button onclick="closeCartModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
            <h3 class="text-lg font-bold text-white mb-4">Your Card Order</h3>
            
            <div id="cart-items" class="flex-1 overflow-y-auto space-y-3 mb-4 pr-1 custom-scrollbar">
                <!-- Cart items populate here -->
            </div>

            <!-- Payment Options & Checkout -->
            <div class="border-t border-slate-800 pt-4 space-y-3">
                <div class="flex justify-between text-sm text-slate-400">
                    <span>Fulfillment Method:</span>
                    <select id="fulfillment-type" onchange="updateCartTotal()" class="bg-slate-800 border border-slate-700 rounded text-slate-200 text-xs px-2 py-1">
                        <option value="pickup">Local Pickup (Cash - Free)</option>
                        <option value="shipping">Tracked Shipping ($4.50)</option>
                    </select>
                </div>
                
                <div class="flex justify-between text-sm text-slate-400">
                    <span>Select Payment Method:</span>
                    <select id="payment-method" class="bg-slate-800 border border-slate-700 rounded text-slate-200 text-xs px-2 py-1">
                        <option value="cashapp">Cash App</option>
                        <option value="paypal">PayPal</option>
                        <option value="applepay">Apple Pay</option>
                        <option value="cash">Cash on Pickup</option>
                    </select>
                </div>

                <div class="flex justify-between text-base font-bold text-white pt-2 border-t border-slate-800">
                    <span>Total Due:</span>
                    <span id="cart-total">$0.00</span>
                </div>
                
                <button onclick="showPaymentInstructions()" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 rounded-lg transition">
                    Proceed to Payment Instructions
                </button>
            </div>
        </div>
    </div>

    <!-- Payment Instruction Overlay Modal -->
    <div id="payment-modal" class="fixed inset-0 bg-slate-950/90 backdrop-blur-md z-50 hidden flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-xl w-full max-w-md p-6 relative text-center">
            <h3 class="text-xl font-bold text-white mb-2" id="payment-title">Payment Instructions</h3>
            <p class="text-slate-400 text-sm mb-4" id="payment-desc"></p>
            
            <div class="bg-slate-950 p-4 rounded-lg border border-slate-800 mb-6 text-left space-y-2 text-xs">
                <div class="flex justify-between"><span class="text-slate-500">Total Amount:</span><span id="pay-amount" class="text-emerald-400 font-bold text-sm"></span></div>
                <div class="flex justify-between"><span class="text-slate-500">Method:</span><span id="pay-method-name" class="text-white font-medium"></span></div>
                <div class="flex justify-between"><span class="text-slate-500">Send To:</span><span id="pay-handle" class="text-blue-400 font-mono font-bold">@YourHandleHere</span></div>
            </div>

            <p class="text-xs text-slate-500 mb-6">After sending payment, message me on OfferUp with your name or item details to confirm your order!</p>

            <button onclick="closePaymentModal()" class="w-full bg-slate-800 hover:bg-slate-700 text-white font-bold py-2.5 rounded-lg transition border border-slate-700">
                Close
            </button>
        </div>
    </div>

    <!-- Application Script -->
    <script>
        let inventory = [];
        let cart = [];

        function renderStorefront() {
            const grid = document.getElementById('card-grid');
            grid.innerHTML = '';

            if (inventory.length === 0) {
                grid.className = "col-span-full flex flex-col items-center justify-center py-20 text-center";
                grid.innerHTML = `
                    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 max-w-md w-full">
                        <div class="w-16 h-16 bg-slate-800 rounded-full flex items-center justify-center mx-auto mb-4 text-slate-500">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                            </svg>
                        </div>
                        <h3 class="text-lg font-bold text-white mb-2">No Cards Listed Yet</h3>
                        <p class="text-slate-400 text-sm mb-6">Your storefront inventory is currently empty and ready for your 1,000-card collection.</p>
                    </div>
                `;
                return;
            }

            grid.className = "grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6";
            
            inventory.forEach(card => {
                const cardEl = document.createElement('div');
                cardEl.className = "gradient-card border border-slate-800 rounded-xl overflow-hidden hover:border-slate-700 transition flex flex-col justify-between";
                cardEl.innerHTML = `
                    <div class="p-4">
                        <div class="flex justify-between items-start mb-2">
                            <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700">${card.year}</span>
                            <span class="text-emerald-400 font-bold">$${card.price.toFixed(2)}</span>
                        </div>
                        <h4 class="font-bold text-white text-base leading-tight">${card.player}</h4>
                        <p class="text-xs text-slate-400 mt-1">${card.set} #${card.number}</p>
                    </div>
                    <div class="p-4 pt-0">
                        <button onclick="addToCart('${card.id}')" class="w-full bg-slate-800 hover:bg-blue-600 text-slate-200 hover:text-white text-xs font-bold py-2 rounded-lg transition border border-slate-700 hover:border-blue-500">
                            Add to Cart
                        </button>
                    </div>
                `;
                grid.appendChild(cardEl);
            });
        }

        function addToCart(cardId) {
            const card = inventory.find(c => c.id === cardId);
            if (card) {
                cart.push(card);
                updateCartCount();
            }
        }

        function updateCartCount() {
            document.getElementById('cart-count').innerText = cart.length;
        }

        function openCartModal() {
            document.getElementById('cart-modal').classList.remove('hidden');
            renderCartItems();
        }

        function closeCartModal() {
            document.getElementById('cart-modal').classList.add('hidden');
        }

        function renderCartItems() {
            const container = document.getElementById('cart-items');
            container.innerHTML = '';

            if (cart.length === 0) {
                container.innerHTML = `<p class="text-slate-500 text-center py-6 text-sm">Your cart is empty.</p>`;
                updateCartTotal();
                return;
            }

            cart.forEach((item, index) => {
                const itemEl = document.createElement('div');
                itemEl.className = "flex justify-between items-center bg-slate-800/50 p-3 rounded-lg border border-slate-800";
                itemEl.innerHTML = `
                    <div>
                        <p class="text-sm font-bold text-white">${item.player}</p>
                        <p class="text-xs text-slate-400">${item.year} ${item.set}</p>
                    </div>
                    <div class="flex items-center space-x-3">
                        <span class="text-emerald-400 font-bold text-sm">$${item.price.toFixed(2)}</span>
                        <button onclick="removeFromCart(${index})" class="text-rose-400 hover:text-rose-300 text-xs">Remove</button>
                    </div>
                `;
                container.appendChild(itemEl);
            });

            updateCartTotal();
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            updateCartCount();
            renderCartItems();
        }

        function updateCartTotal() {
            const subtotal = cart.reduce((sum, item) => sum + item.price, 0);
            const fulfillment = document.getElementById('fulfillment-type').value;
            const shippingFee = fulfillment === 'shipping' && cart.length > 0 ? 4.50 : 0.00;
            const total = subtotal + shippingFee;
            
            document.getElementById('cart-total').innerText = `$${total.toFixed(2)}`;
        }

        function showPaymentInstructions() {
            if (cart.length === 0) {
                alert("Please add at least one card to your cart.");
                return;
            }

            const method = document.getElementById('payment-method').value;
            const totalText = document.getElementById('cart-total').innerText;
            
            document.getElementById('pay-amount').innerText = totalText;

            if (method === 'cashapp') {
                document.getElementById('payment-title').innerText = "Cash App Payment";
                document.getElementById('payment-desc').innerText = "Send your total payment via Cash App to the cashtag below:";
                document.getElementById('pay-method-name').innerText = "Cash App";
                document.getElementById('pay-handle').innerText = "$YourCashtagHere";
            } else if (method === 'paypal') {
                document.getElementById('payment-title').innerText = "PayPal Payment";
                document.getElementById('payment-desc').innerText = "Send payment to the PayPal username or email below:";
                document.getElementById('pay-method-name').innerText = "PayPal";
                document.getElementById('pay-handle').innerText = "your.email@example.com";
            } else if (method === 'applepay') {
                document.getElementById('payment-title').innerText = "Apple Pay Payment";
                document.getElementById('payment-desc').innerText = "Send Apple Cash to the phone number or Apple ID below:";
                document.getElementById('pay-method-name').innerText = "Apple Pay";
                document.getElementById('pay-handle').innerText = "(555) 123-4567";
            } else {
                document.getElementById('payment-title').innerText = "Cash on Local Pickup";
                document.getElementById('payment-desc').innerText = "Bring exact cash to the designated public meetup spot!";
                document.getElementById('pay-method-name').innerText = "Cash";
                document.getElementById('pay-handle').innerText = "In-Person Meetup";
            }

            closeCartModal();
            document.getElementById('payment-modal').classList.remove('hidden');
        }

        function closePaymentModal() {
            document.getElementById('payment-modal').classList.add('hidden');
        }

        function filterCards() {}

        renderStorefront();
    </script>
</body>
</html>
